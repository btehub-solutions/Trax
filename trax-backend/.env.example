# Copy to .env — required for local backend (npm run start:dev)

# PostgreSQL (Supabase, Neon, or local Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/trax

# Optional: Prisma direct connection (Supabase pooler bypass)
# DIRECT_URL=postgresql://user:password@localhost:5432/trax

# Auth — required
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — comma-separated origins allowed to call the API
FRONTEND_ORIGIN=http://localhost:3000

# Transactional email (Resend) — required in production for newsletter confirm
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Trax <newsletter@trax.ng>

PORT=4000

# Optional: Supabase storage for uploads (production)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
