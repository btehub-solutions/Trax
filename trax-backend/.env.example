# Use local or staging values here. Keep production secrets only in production hosting settings.

# Required for local backend development.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/trax_dev"

# Optional direct URL for migrations against a safe local/staging database.
# DIRECT_URL="postgres://postgres:postgres@localhost:5432/trax_dev"

# Local server.
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Use a long random value locally. Use a different secret in production.
JWT_SECRET=replace-with-a-long-local-development-secret
JWT_EXPIRES_IN=7d

# Optional storage credentials.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Safety flags. Leave these unset by default.
# ALLOW_REMOTE_DATABASE_IN_DEVELOPMENT=true
# CONFIRM_DESTRUCTIVE_SEED=true
