# Local frontend should talk to the local backend by default.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Canonical site URL for sitemap, Open Graph, and JSON-LD (production: https://trax.ng)
NEXT_PUBLIC_SITE_URL=https://trax.ng

# Optional analytics IDs.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-KC611DM9ZN
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Safety flag. Leave unset unless pointing at a confirmed non-production staging API.
# NEXT_PUBLIC_ALLOW_REMOTE_API_IN_DEVELOPMENT=true
